{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXO V3",
  "version": "0.0.0",
  "identifier": "ai.nexo.v3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NEXO V3 IDE",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
